# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Service Scheduler

# Internationalization
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_SUPPORTED_LOCALES=es,en,pt

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email
RESEND_API_KEY=
EMAIL_FROM=

# Cron
CRON_SECRET=

# WhatsApp MVP links
NEXT_PUBLIC_WHATSAPP_COUNTRY_CODE=54

# Initial organization defaults
SEED_ORGANIZATION_NAME=Demo Service Company
SEED_ORGANIZATION_SLUG=demo-service-company
SEED_ORGANIZATION_TIMEZONE=America/Argentina/Buenos_Aires

# AI / Gemini (server-only — never prefix with NEXT_PUBLIC_)
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Legacy aliases (GEMINI_API_KEY / GEMINI_MODEL take precedence):
# AI_API_KEY=
# AI_MODEL=

